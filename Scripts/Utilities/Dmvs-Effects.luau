local BASE_EFFECTS_URL = "https://raw.githubusercontent.com/Xyraniz/Roblox/e14da64e7832ad6a756801e5882516699b1cc952/Scripts/Utilities/Dmvs-Effects.luau"
local effectBuilders = assert(loadstring(game:HttpGet(BASE_EFFECTS_URL)))()
assert(type(effectBuilders) == "table", "Base effects must return a table")

local HttpService = game:GetService("HttpService")
local AssetService = game:GetService("AssetService")
local InsertService = game:GetService("InsertService")
local meshCache = {}

local function decodeValue(encoded, objects)
    if type(encoded) ~= "table" then return encoded end

    local kind = encoded[1]
    if kind == "v2" then return Vector2.new(encoded[2], encoded[3]) end
    if kind == "v3" then return Vector3.new(encoded[2], encoded[3], encoded[4]) end
    if kind == "col" then return Color3.new(encoded[2], encoded[3], encoded[4]) end
    if kind == "range" then return NumberRange.new(encoded[2], encoded[3]) end
    if kind == "cf" then return CFrame.new(table.unpack(encoded, 2)) end
    if kind == "ref" then return objects[encoded[2]] end

    if kind == "enum" then
        local enumType, enumName = encoded[2]:match("^Enum%.([^.]+)%.([^.]+)$")
        if not enumType then return nil end
        local ok, value = pcall(function()
            return Enum[enumType][enumName]
        end)
        return ok and value or nil
    end

    if kind == "nums" then
        local keypoints = table.create(#encoded[2])
        for i, point in ipairs(encoded[2]) do
            keypoints[i] = NumberSequenceKeypoint.new(point[1], point[2], point[3])
        end
        return NumberSequence.new(keypoints)
    end

    if kind == "cols" then
        local keypoints = table.create(#encoded[2])
        for i, point in ipairs(encoded[2]) do
            keypoints[i] = ColorSequenceKeypoint.new(point[1], Color3.new(point[2], point[3], point[4]))
        end
        return ColorSequence.new(keypoints)
    end

    return nil
end

local function createMeshPart(meshId)
    local cached = meshCache[meshId]
    if cached == nil then
        local ok, mesh = pcall(function()
            return AssetService:CreateMeshPartAsync(Content.fromUri(meshId), {})
        end)
        if not ok or not mesh then
            ok, mesh = pcall(function()
                return InsertService:CreateMeshPartAsync(meshId, Enum.CollisionFidelity.Default, Enum.RenderFidelity.Automatic)
            end)
        end
        cached = ok and typeof(mesh) == "Instance" and mesh or false
        meshCache[meshId] = cached
    end
    if cached then return cached:Clone() end

    local part = Instance.new("Part")
    local mesh = Instance.new("SpecialMesh")
    mesh.MeshType = Enum.MeshType.FileMesh
    mesh.MeshId = meshId
    mesh.Parent = part
    return part
end

local function buildCapturedEffect(data, origin)
    local records = HttpService:JSONDecode(data)
    local objects = table.create(#records)

    for i, record in ipairs(records) do
        local ok, instance
        if record[1] == "MeshPart" then
            ok, instance = pcall(createMeshPart, record[4].MeshId)
        else
            ok, instance = pcall(Instance.new, record[1])
        end

        if not ok or not instance then
            for _, created in ipairs(objects) do
                created:Destroy()
            end
            return nil
        end
        objects[i] = instance
        instance.Name = record[2]
        if instance:IsA("BasePart") then
            instance.Anchored = true
            instance.CanCollide = false
            instance.CanTouch = false
            instance.CanQuery = false
        end
    end

    for i, record in ipairs(records) do
        local parent = objects[record[3]]
        if parent then objects[i].Parent = parent end
    end

    for i, record in ipairs(records) do
        local instance = objects[i]
        local properties = record[4]

        for property, encoded in pairs(properties) do
            if property ~= "CFrame" and property ~= "Position"
                and property ~= "WorldCFrame" and property ~= "MeshId" then
                local ok, value = pcall(decodeValue, encoded, objects)
                if ok and value ~= nil then
                    pcall(function() instance[property] = value end)
                end
            end
        end

        local transform = properties.CFrame or properties.Position
        if transform then
            local ok, value = pcall(decodeValue, transform, objects)
            if ok and value then
                if properties.CFrame then
                    pcall(function() instance.CFrame = value end)
                else
                    pcall(function() instance.Position = value end)
                end
            end
        end

        if record[1] == "MeshPart" and instance:IsA("Part") then
            local mesh = instance:FindFirstChildOfClass("SpecialMesh")
            if mesh then mesh.Scale = instance.Size end
        end

        for attribute, encoded in pairs(record[5]) do
            local ok, value = pcall(decodeValue, encoded, objects)
            if ok and value ~= nil then
                pcall(function() instance:SetAttribute(attribute, value) end)
            end
        end

        if instance:IsA("BasePart") then
            instance.Anchored = true
            instance.CanCollide = false
            instance.CanTouch = false
            instance.CanQuery = false
        end
    end

    local root = objects[1]
    if root then root:SetAttribute("DMVS_EffectOrigin", origin) end
    return root
end

