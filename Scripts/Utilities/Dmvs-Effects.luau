}

local function dmvsCloneReplicatedEffectTemplate(name)
    local skins = dmvsEffectsStorage:FindFirstChild("ReplicatedSkins")
    if not skins then return nil end
    local effects = skins:FindFirstChild("Effects")
    local previews = skins:FindFirstChild("PreviewEffects")
    local source = (effects and effects:FindFirstChild(name))
        or (previews and previews:FindFirstChild(name))
    if not source or not (source:IsA("BasePart") or source:IsA("Model") or source:IsA("Folder")) then
        return nil
    end
    local cloned = source:Clone()
    if not cloned or not cloned:FindFirstChildWhichIsA("ParticleEmitter", true) then
        if cloned then cloned:Destroy() end
        return nil
    end
    return cloned
end

local dmvsVisualEffectBuilders = {
    SpiritOverload = dmvsCreateSpiritOverloadTemplate,
    BunnyBoys = dmvsCreateBunnyBoysTemplate,
    Freeze = dmvsCreateFreezeTemplate,
    SakuraEffect = dmvsCreateSakuraEffectTemplate,
    Frostbite = dmvsCreateFrostbiteTemplate
}
for effectName in pairs(dmvsReplicatedVisualEffects) do
    local name = effectName
    dmvsVisualEffectBuilders[name] = function()
        return dmvsCloneReplicatedEffectTemplate(name)
    end
end


local dmvsCapturedMeshCache = {}
local dmvsCapturedHttp = game:GetService("HttpService")
local dmvsCapturedAssetService = game:GetService("AssetService")
local dmvsCapturedInsertService = game:GetService("InsertService")

local function dmvsCapturedValue(v, created)
    if type(v) ~= "table" then return v end
    local kind = v[1]
    if kind == "v2" then return Vector2.new(v[2], v[3]) end
    if kind == "v3" then return Vector3.new(v[2], v[3], v[4]) end
    if kind == "col" then return Color3.new(v[2], v[3], v[4]) end
    if kind == "range" then return NumberRange.new(v[2], v[3]) end
    if kind == "cf" then return CFrame.new(select(2, table.unpack(v))) end
    if kind == "ref" then return created[v[2]] end
    if kind == "enum" then
        local group, item = string.match(v[2], "^Enum%.([^.]+)%.([^.]+)$")
        if not group then return nil end
        local ok, result = pcall(function() return Enum[group][item] end)
        return ok and result or nil
    end
    if kind == "nums" then
        local pts = {}
        for _, p in ipairs(v[2]) do pts[#pts+1] = NumberSequenceKeypoint.new(p[1], p[2], p[3]) end
        return NumberSequence.new(pts)
    end
    if kind == "cols" then
        local pts = {}
        for _, p in ipairs(v[2]) do
            pts[#pts+1] = ColorSequenceKeypoint.new(p[1], Color3.new(p[2], p[3], p[4]))
        end
        return ColorSequence.new(pts)
    end
    return nil
end

local function dmvsCreateCapturedMesh(meshId)
    if type(meshId) ~= "string" or meshId == "" then
        return Instance.new("MeshPart")
    end
    local normalizedId = string.match(meshId, "[?&]id=(%d+)")
    if normalizedId then meshId = "rbxassetid://" .. normalizedId end
    local cached = dmvsCapturedMeshCache[meshId]
    if cached == nil then
        local success, result = pcall(function()
            return dmvsCapturedAssetService:CreateMeshPartAsync(Content.fromUri(meshId), {})
        end)
        if not success or not result then
            success, result = pcall(function()
                return dmvsCapturedInsertService:CreateMeshPartAsync(
                    meshId, Enum.CollisionFidelity.Default, Enum.RenderFidelity.Automatic)
            end)
        end
        cached = success and typeof(result) == "Instance" and result or false
        dmvsCapturedMeshCache[meshId] = cached
    end
    if cached then return cached:Clone() end
    local part = Instance.new("Part")
    local mesh = Instance.new("SpecialMesh")
    mesh.MeshType = Enum.MeshType.FileMesh
    mesh.MeshId = meshId
    mesh.Parent = part
    return part
end

local function dmvsBuildCapturedEffect(name, capture)
    local records = dmvsCapturedHttp:JSONDecode(capture)
    local created = table.create(#records)
    for i, record in ipairs(records) do
        local kind, props = record[1], record[4]
        local obj
        if kind == "MeshPart" then
            obj = dmvsCreateCapturedMesh(props.MeshId)
        else
            local ok, inst = pcall(Instance.new, kind)
            if not ok then
                for _, prior in pairs(created) do if prior then prior:Destroy() end end
                return nil
            end
            obj = inst
        end
        obj.Name = record[2]
        if obj:IsA("BasePart") then
            obj.Anchored = true
            obj.CanCollide = false
            obj.CanTouch = false
            obj.CanQuery = false
        end
        created[i] = obj
    end
    for i, record in ipairs(records) do
        local parent = created[record[3]]
        if parent then created[i].Parent = parent end
    end
    for i, record in ipairs(records) do
        local instance = created[i]
        for prop, value in pairs(record[4]) do
            if prop ~= "MeshId" then
                local ok, decoded = pcall(dmvsCapturedValue, value, created)
                if ok and decoded ~= nil then setProperty(instance, prop, decoded) end
            end
        end
        if record[1] == "MeshPart" and instance:IsA("Part") then
            local specialMesh = instance:FindFirstChildOfClass("SpecialMesh")
            if specialMesh then
                specialMesh.Scale = instance.Size
                local texture = record[4].TextureID
                if type(texture) == "string" and texture ~= "" then
                    setProperty(specialMesh, "TextureId", texture)
                end
            end
        end
        for attr, value in pairs(record[5]) do
            pcall(function() instance:SetAttribute(attr, value) end)
        end
    end
    local root = created[1]
    if not root then return nil end
    local originPart
    if name == "BlueJelly" or name == "GreenJelly" or name == "PurpleJelly" or name == "RedJelly" then
        originPart = root:FindFirstChild(string.lower(name) .. "effect")
    elseif name == "RocketEffect" then
        local rocket = root:FindFirstChild("Rocket")
        originPart = rocket and (rocket.PrimaryPart or rocket:FindFirstChild("Body"))
    elseif name == "UFOEffect" then
        local model = root:FindFirstChild("UFO Death")
        originPart = model and model:FindFirstChild("HumanoidRootPart")
    elseif name == "VenomEffect" then
        local model = root:FindFirstChild("Venom Death")
        originPart = model and model:FindFirstChild("HumanoidRootPart")
    end
    root:SetAttribute("DMVS_EffectOrigin", originPart and originPart.CFrame or CFrame.new())
    if name == "RocketEffect" then root:SetAttribute("DMVS_EffectType", "Rocket") end
    if name == "UFOEffect" or name == "VenomEffect" then
        root:SetAttribute("DMVS_EffectType", "Cinematic")
    end
    local animationName = ({BlueJelly = "JellyAnim", GreenJelly = "JellyAnim",
        PurpleJelly = "JellyAnim", RedJelly = "JellyAnim", UFOEffect = "UFODeath",
        VenomEffect = "VenomDeath"})[name]
    if animationName then
        local animation = root:FindFirstChild(animationName, true)
        if animation and animation:IsA("Animation") then
            animation:SetAttribute("DMVS_AutoPlay", true)
        end
    end
    return root
end

