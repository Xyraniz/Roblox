for name, capture in pairs(additionalEffectCaptures) do
    local builder = createBuilder(capture, effectOrigins[name])
    if name == "ClanFlagEffect" then
        dmvsVisualEffectBuilders[name] = function()
            local root = builder()
            if root then
                local flag = root:FindFirstChild("Flag")
                local effect = root:FindFirstChild("flagdeathkilleffect")
                if flag and flag:IsA("Model") and effect and effect:IsA("BasePart") then
                    local pivot = flag:GetPivot()
                    flag:PivotTo(CFrame.new(effect.Position) * (pivot - pivot.Position))
                end
            end
            return root
        end
    else
        dmvsVisualEffectBuilders[name] = builder
    end
end

return dmvsVisualEffectBuilders
