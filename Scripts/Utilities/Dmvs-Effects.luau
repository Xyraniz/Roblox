local dmvsOriginalEffects = "https://raw.githubusercontent.com/Xyraniz/Roblox/ce8dccedc2bacd53878c93da19effc96ac3be1c3/Scripts/Utilities/Dmvs-Effects.luau"
local dmvsOriginalSource = game:HttpGet(dmvsOriginalEffects)
local dmvsOriginalChunk = assert(loadstring(dmvsOriginalSource))
local dmvsVisualEffectBuilders = dmvsOriginalChunk()
assert(type(dmvsVisualEffectBuilders) == "table", "Unable to load original DMVS effects")

local dmvsHttp = game:GetService("HttpService")

local function dmvsDecodeCapturedValue(value, created)
    if type(value) ~= "table" then return value end
    local kind = value[1]
    if kind == "v2" then return Vector2.new(value[2], value[3]) end
    if kind == "v3" then return Vector3.new(value[2], value[3], value[4]) end
    if kind == "col" then return Color3.new(value[2], value[3], value[4]) end
    if kind == "range" then return NumberRange.new(value[2], value[3]) end
    if kind == "cf" then return CFrame.new(table.unpack(value, 2)) end
    if kind == "ref" then return created[value[2]] end
    if kind == "enum" then
        local group, member = value[2]:match("^Enum%.([^.]+)%.([^.]+)$")
        if not group then return nil end
        local ok, result = pcall(function() return Enum[group][member] end)
        return ok and result or nil
    end
    if kind == "nums" then
        local keys = table.create(#value[2])
        for i, point in ipairs(value[2]) do
            keys[i] = NumberSequenceKeypoint.new(point[1], point[2], point[3])
        end
        return NumberSequence.new(keys)
    end
    if kind == "cols" then
        local keys = table.create(#value[2])
        for i, point in ipairs(value[2]) do
            keys[i] = ColorSequenceKeypoint.new(point[1], Color3.new(point[2], point[3], point[4]))
        end
        return ColorSequence.new(keys)
    end
    return nil
end

local function dmvsBuildNewCapture(name, jsonText, origin)
    local records = dmvsHttp:JSONDecode(jsonText)
    local made = table.create(#records)
    for i, record in ipairs(records) do
        local class = record[1]
        local ok, object = pcall(Instance.new, class)
        if not ok or not object then
            for _, previous in ipairs(made) do previous:Destroy() end
            return nil
        end
        made[i] = object
        object.Name = record[2]
        if object:IsA("BasePart") then
            object.Anchored = true
            object.CanCollide = false
            object.CanTouch = false
            object.CanQuery = false
        end
    end
    for i, record in ipairs(records) do
        local parent = made[record[3]]
        if parent then made[i].Parent = parent end
    end
    for i, record in ipairs(records) do
        local instance = made[i]
        local props = record[4]
        for property, source in pairs(props) do
            if property ~= "CFrame" and property ~= "Position" then
                local ok, decoded = pcall(dmvsDecodeCapturedValue, source, made)
                if ok and decoded ~= nil then
                    pcall(function() instance[property] = decoded end)
                end
            end
        end
        if props.CFrame then
            local ok, decoded = pcall(dmvsDecodeCapturedValue, props.CFrame, made)
            if ok and decoded then
                pcall(function() instance.CFrame = decoded end)
            end
        elseif props.Position then
            local ok, decoded = pcall(dmvsDecodeCapturedValue, props.Position, made)
            if ok and decoded then
                pcall(function() instance.Position = decoded end)
            end
        end
        for attribute, encoded in pairs(record[5]) do
            local ok, decoded = pcall(dmvsDecodeCapturedValue, encoded, made)
            if ok and decoded ~= nil then
                pcall(function() instance:SetAttribute(attribute, decoded) end)
            end
        end
    end
    local root = made[1]
    if root then root:SetAttribute("DMVS_EffectOrigin", origin) end
    return root
end

